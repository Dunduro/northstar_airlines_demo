# Copy to .env to override. These defaults are for LOCAL DEMO ONLY — never reuse them.
# In production both secrets live in AWS Secrets Manager and the JWT comes from Entra ID.

# HMAC secret shared between the pipeline (GitHub Actions / HR system) and the API.
WEBHOOK_SECRET=local-dev-only-webhook-secret

# Signing key for the SIMULATED Entra ID tokens (dev login). Production validates
# Entra-issued RS256 tokens against the tenant's JWKS instead.
JWT_SECRET=local-dev-only-jwt-secret

# Postgres (docker compose maps it to localhost:54329)
DATABASE_URL=postgres://northstar:northstar@localhost:54329/northstar

# Used by the simulator when run from your machine.
API_URL=http://localhost:3000
MOCK_URL=http://localhost:4000
