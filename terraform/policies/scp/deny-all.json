{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyEverythingExceptControlTower",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/AWSControlTowerExecution"
        }
      }
    }
  ]
}
